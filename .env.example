# Copie para .env e preencha. Nunca versione o arquivo .env.

# development | test | production
APP_ENV=development

# Produção: PostgreSQL. Desenvolvimento: SQLite local é suficiente.
# DATABASE_URL=postgresql://flayks:troque-esta-senha@db:5432/flayks
DATABASE_URL=sqlite:///./dev.db

# Obrigatório em produção, mínimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookie de sessão só por HTTPS (padrão: true em produção, false em desenvolvimento)
# COOKIE_SECURE=true

# Só necessário se o frontend rodar em outra origem (ex.: http://localhost:5173 sem proxy)
# CORS_ORIGINS=http://localhost:5173

# true somente atrás de um proxy reverso confiável (nginx do docker-compose)
TRUST_PROXY=false

# Assistente de IA (opcional). Sem chave, o assistente fica desativado no site.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# Senha do PostgreSQL usada pelo docker-compose
POSTGRES_PASSWORD=
